{
  // Cloudflare Workers static-assets deploy for MPL Scan.
  // Builds the Vite app, then serves ./dist (including public/_headers).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mpl-report",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
